diff --git a/contexts/RevealContext.tsx b/contexts/RevealContext.tsx
new file mode 100644
index 0000000..fc4a333
--- /dev/null
+++ b/contexts/RevealContext.tsx
@@ -0,0 +1,50 @@
+"use client";
+
+import { createContext, useContext, useEffect, useState } from "react";
+
+interface RevealContextType {
+  revealed: boolean;
+  reveal: () => void;
+}
+
+const RevealContext = createContext<RevealContextType | null>(null);
+
+const STORAGE_KEY = "plum-cake:moon-revealed";
+
+export function RevealProvider({ children }: { children: React.ReactNode }) {
+  const [revealed, setRevealed] = useState(false);
+
+  // On mount, skip the intro if the visitor already saw it this session.
+  useEffect(() => {
+    const seen = sessionStorage.getItem(STORAGE_KEY) === "true";
+    if (seen) setRevealed(true);
+  }, []);
+
+  useEffect(() => {
+    document.body.style.overflow = revealed ? "" : "hidden";
+    return () => {
+      document.body.style.overflow = "";
+    };
+  }, [revealed]);
+
+  const reveal = () => {
+    setRevealed(true);
+    sessionStorage.setItem(STORAGE_KEY, "true");
+  };
+
+  return (
+    <RevealContext.Provider value={{ revealed, reveal }}>
+      {children}
+    </RevealContext.Provider>
+  );
+}
+
+export function useReveal() {
+  const context = useContext(RevealContext);
+
+  if (!context) {
+    throw new Error("useReveal must be used inside RevealProvider");
+  }
+
+  return context;
+}
